{
  "id": "dws-send-approval",
  "name": "DWS Reply Assistant",
  "description": "Owner-controlled DingTalk reply assistant with cards and preauthorized exact answers.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ownerUserId",
      "dwsPath",
      "listener"
    ],
    "properties": {
      "agentId": {
        "type": "string",
        "default": "main",
        "pattern": "^[a-z0-9_-]+$"
      },
      "accountId": {
        "type": "string",
        "default": "default"
      },
      "ownerUserId": {
        "type": "string",
        "minLength": 1
      },
      "profile": {
        "type": "string",
        "minLength": 1,
        "description": "Deprecated: optional consistency check only. Identity is discovered from DWS currentProfile."
      },
      "dwsPath": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 600000,
        "default": 120000
      },
      "listener": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "all-direct",
              "all-group",
              "at-me",
              "sender",
              "group",
              "all-direct-and-at-me"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "ignoreSenderOpenIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Additional excluded senders. The channel robot open ID is discovered automatically."
          },
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Seed only on first start; employee preferences persist separately. Default off."
          }
        }
      },
      "mode": {
        "type": "string",
        "enum": [
          "approval",
          "block"
        ],
        "default": "approval"
      },
      "assistant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "cardTemplateId": {
            "type": "string"
          },
          "draftTtlMinutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 10080,
            "default": 1440
          },
          "cardTtlMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 30,
            "description": "Card interaction lifetime in minutes; navigation does not extend it."
          },
          "cards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expiryCheckSeconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 60,
                "default": 10,
                "description": "Lightweight card expiry checks; independent of card lifetime and storage cleanup."
              },
              "presentationVersion": {
                "type": "integer",
                "enum": [
                  2,
                  3
                ],
                "default": 2,
                "description": "Card presentation version. Select 3 only after publishing and validating the rich template; keeps one active template ID."
              }
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retentionDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "default": 7
              },
              "expiredCardRetentionHours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168,
                "default": 24
              },
              "cleanupIntervalSeconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 86400,
                "default": 300
              },
              "dedupeRetentionDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365,
                "default": 30
              }
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "historyMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60,
                "default": 5,
                "description": "近期对话文字窗口（分钟），0 关闭；不读取附件"
              }
            }
          },
          "directBatch": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mergeGapSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300,
                "default": 30
              }
            }
          },
          "drafting": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "toolsEnabled": {
                "type": "boolean",
                "default": false,
                "description": "使用经过只读校验的专用 Agent，默认关闭"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 600,
                "default": 120,
                "description": "Agent 起草等候预算；超时不代表宿主任务已取消"
              },
              "agentId": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,128}$",
                "description": "受限起草 Agent ID，缺省继承顶层 agentId"
              },
              "documentWorkspaceIds": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "default": [],
                "description": "允许检索的知识库范围，留空不开放文档检索"
              }
            }
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "dws_draft_history",
      "dws_draft_contact",
      "dws_draft_search",
      "dws_draft_read"
    ]
  }
}
