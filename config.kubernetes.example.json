{
  "commands": {
    "text": true,
    "allowFrom": {
      "dingtalk": ["${OC_OWNER_STAFF_ID}"]
    }
  },
  "approvals": {
    "plugin": {
      "enabled": true,
      "mode": "targets",
      "targets": [
        {
          "channel": "dingtalk",
          "accountId": "default",
          "to": "user:${OC_OWNER_STAFF_ID}"
        }
      ]
    }
  },
  "plugins": {
    "entries": {
      "dws-send-approval": {
        "enabled": true,
        "config": {
          "agentId": "main",
          "accountId": "default",
          "ownerUserId": "${OC_OWNER_STAFF_ID}",
          "dwsPath": "/usr/local/bin/dws",
          "mode": "approval",
          "timeoutMs": 120000,
          "identityPolicy": {
            "allowExistingBindingMigration": false
          },
          "listener": {
            "enabled": false
          },
          "assistant": {
            "enabled": true,
            "cardTemplateId": "${OC_DWS_ASSISTANT_CARD_TEMPLATE_ID}",
            "draftTtlMinutes": 1440,
            "cardTtlMinutes": 30,
            "cards": {
              "expiryCheckSeconds": 10,
              "presentationVersion": 2
            },
            "storage": {
              "retentionDays": 7,
              "expiredCardRetentionHours": 24,
              "cleanupIntervalSeconds": 300,
              "dedupeRetentionDays": 30
            },
            "context": {
              "historyMinutes": 5
            },
            "directBatch": {
              "mergeGapSeconds": 30
            },
            "drafting": {
              "toolsEnabled": false,
              "timeoutSeconds": 120,
              "documentWorkspaceIds": []
            }
          }
        }
      }
    }
  }
}
